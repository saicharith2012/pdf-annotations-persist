{
  "manifest_version": 3,
  "name": "Persistent PDF Annotations",
  "version": "0.1.0",
  "description": "Highlight and doodle on PDFs in the browser. Marks are written into the PDF itself, so they are still there next time.",
  "minimum_chrome_version": "128",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "unlimitedStorage",
    "webRequest",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>",
    "file:///*"
  ],
  "options_page": "src/options.html",
  "action": {
    "default_title": "Persistent PDF Annotations",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/viewer.html",
        "vendor/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
